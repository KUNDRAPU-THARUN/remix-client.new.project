# AI Studio Applet Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Supabase Backend Configuration (Vite)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# Supports either VITE_SUPABASE_ANON_KEY (Supabase standard) or VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional alias:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Staging Project Reference (Vercel Preview):
# VITE_SUPABASE_URL=https://tbwtxnszyddvpgqvxwow.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Production Project Reference (Vercel Production):
# VITE_SUPABASE_URL=https://gpqbppjqqndzuvksrtjb.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
